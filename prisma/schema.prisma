// Loja Vênus — schema Prisma
// Fase 0: autenticação (Auth.js) + configurações da loja.
// Fase 1: catálogo (categorias, marcas, produtos, imagens, especificações).
// Fase 4: pagamento (Mercado Pago Checkout Pro) — campos de gateway em Payment.
// Fase 5: frete (Melhor Envio) — dados físicos em Product + snapshot ShippingQuote.
// Pedidos, estoque, financeiro e fiscal completam-se nas fases seguintes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Autenticação / autorização (staff do painel administrativo)
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STAFF)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // Operações (pedidos/estoque): quem executou a movimentação / registrou o evento.
  stockMovements StockMovement[]
  orderEvents    OrderEvent[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Configurações da loja (substitui src/config/store.ts)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catálogo (Fase 1)
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)

  // Dinheiro sempre em centavos (inteiro). A UI converte para reais na borda.
  priceCents          Int
  compareAtPriceCents Int?

  // Estoque: saldo em cache. O livro-razão (histórico) fica em StockMovement.
  // Sem baixa automática nesta etapa — apenas o campo.
  stockOnHand Int @default(0)

  // Dados físicos para cotação de frete (Fase 5 — Melhor Envio). Sempre inteiros:
  // peso em gramas, dimensões em centímetros. Defaults seguros (caixa pequena de
  // perfume) cobrem produtos já cadastrados e o seed; ajuste por produto no admin.
  // Os defaults respeitam os mínimos dos Correios (compr. >= 15, larg. >= 10).
  weightGrams Int @default(300)
  heightCm    Int @default(6)
  widthCm     Int @default(11)
  lengthCm    Int @default(16)

  // Avaliações — herdadas do catálogo estático; sistema de reviews é fase futura.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  // Fallback visual quando não há imagem (degradê + ícone), como na SPA original.
  iconKey  String?
  gradient String?

  categoryId String
  brandId    String
  category   Category @relation(fields: [categoryId], references: [id])
  brand      Brand    @relation(fields: [brandId], references: [id])

  images         ProductImage[]
  specs          ProductSpec[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String?
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpec {
  id        String @id @default(cuid())
  productId String
  label     String
  value     String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Operações: clientes, pedidos, pagamentos, entregas, notas fiscais, estoque.
// SOMENTE modelagem — carrinho/checkout/pagamento/WhatsApp/NF-e/estoque
// automático NÃO são implementados nesta etapa.
//
// Dinheiro: sempre Int em centavos (padrão da Fase 1, helpers em src/lib/format.ts).
// Endereço do pedido: snapshot imutável em OrderAddress (não referencia cadastro).
// OrderItem: snapshot de nome/preço no momento da compra — nunca depende do
// preço atual de Product; a FK com Product é só referência histórica.
// ---------------------------------------------------------------------------

enum OrderSource {
  WEBSITE
  WHATSAPP
  // Novas origens entram por migration (ALTER TYPE ADD VALUE) — sem recriar a entidade.
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

// Status de pagamento é independente de OrderStatus.
enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  CHARGEBACK
  FAILED
  CANCELED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  CASH
  BANK_TRANSFER
  OTHER
}

enum ShipmentStatus {
  PENDING
  READY
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELED
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELED
  ERROR
}

enum StockMovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  RETURN
}

enum StockMovementReason {
  PURCHASE
  SALE
  MANUAL_ADJUSTMENT
  CUSTOMER_RETURN
  LOSS
  INVENTORY_COUNT
  OTHER
}

enum OrderEventType {
  ORDER_STATUS_CHANGED
  PAYMENT_STATUS_CHANGED
  NOTE
}

// --- Cliente da loja -------------------------------------------------------
// NÃO é um usuário autenticado (User = staff do painel). Cliente não faz login.
// Pedido pode existir sem Customer (guest / WhatsApp) — ver Order.customerId.

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  document  String? // CPF/CNPJ — uso futuro
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([email])
  @@index([phone])
}

// --- Pedido (estrutura central única: site + WhatsApp) --------------------

model Order {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement()) // referência humana

  source        OrderSource
  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Snapshot de contato — funciona sem Customer (guest / WhatsApp).
  customerName  String
  customerEmail String?
  customerPhone String?

  // Valores em centavos (inteiro).
  subtotalCents Int
  discountCents Int    @default(0)
  shippingCents Int    @default(0)
  totalCents    Int
  currency      String @default("BRL")

  notes String?

  items         OrderItem[]
  address       OrderAddress?
  payments      Payment[]
  shipment      Shipment?
  shippingQuote ShippingQuote?
  invoices      Invoice[]
  events        OrderEvent[]

  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([createdAt])
}

// --- Item do pedido (SNAPSHOT de preço no momento da compra) --------------

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Referência histórica — Restrict impede apagar produto já vendido.
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot congelado na compra — NUNCA lê o preço atual de Product.
  productName     String
  productSlug     String
  productImageUrl String?
  unitPriceCents  Int
  quantity        Int
  discountCents   Int     @default(0)
  totalCents      Int // unitPriceCents * quantity - discountCents

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// --- Endereço do pedido (SNAPSHOT imutável) ------------------------------
// Cópia dos dados no momento do pedido. Alterar cadastro do cliente no
// futuro NÃO altera este registro.

model OrderAddress {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipientName String
  zipCode       String
  state         String
  city          String
  neighborhood  String
  street        String
  number        String
  complement    String?
  reference     String?
  phone         String?

  createdAt DateTime @default(now())
}

// --- Pagamento (1 pedido -> N tentativas) -------------------------------
// Registro manual pelo admin OU alimentado pelo gateway (Mercado Pago, Fase 4).
// NUNCA armazenar dados sensíveis de cartão. Order.paymentStatus é sempre
// derivado da soma dos Payments (summarizePayments), nunca setado direto.

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int

  // Gateway. `provider` = "mercadopago" quando originado pelo Checkout Pro.
  // `providerPaymentId` = id do pagamento no gateway. `providerStatus` = status
  // cru do gateway visto por último (ex.: "approved", "refunded") — usado como
  // chave de idempotência do webhook e para auditoria.
  provider          String?
  providerPaymentId String?
  providerStatus    String?
  paidAt            DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um pagamento do gateway (provider + providerPaymentId) mapeia para no máximo
  // um Payment. NULLs não colidem no Postgres, então registros manuais
  // (provider/providerPaymentId nulos) não são afetados.
  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status])
}

// --- Entrega (1:1 com o pedido) ---------------------------------------
// Endereço vem de OrderAddress (não duplicado). Sem logística nesta etapa.

model Shipment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status       ShipmentStatus @default(PENDING)
  carrier      String?
  trackingCode String?
  estimatedAt  DateTime? // data prevista
  shippedAt    DateTime?
  deliveredAt  DateTime? // data de entrega
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// --- Cotação de frete escolhida no checkout (SNAPSHOT imutável) --------
// Fase 5 — Melhor Envio. Registra a opção de frete que o cliente escolheu e que
// foi RECOTADA no servidor antes de criar o pedido (o preço enviado pelo cliente
// nunca é autoritativo). É 1:1 com Order e independente de Shipment: atualizar a
// entrega (Shipment) no pós-venda NUNCA altera este snapshot. `priceCents` aqui
// deve bater com `Order.shippingCents` no momento da criação do pedido.
model ShippingQuote {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Origem (config da loja) e destino (CEP do endereço de entrega) usados na cotação.
  originZip String
  destZip   String

  // Provedor e serviço escolhido — snapshot. `provider` = "melhorenvio" nesta fase.
  // `serviceCode` = id do serviço no Melhor Envio; `serviceName`/`carrier` p/ exibição.
  provider    String @default("melhorenvio")
  serviceCode String
  serviceName String
  carrier     String

  // Valor do frete escolhido, em centavos (inteiro).
  priceCents Int

  // Prazo estimado em dias úteis, conforme a cotação (pode não vir).
  deliveryDaysMin Int?
  deliveryDaysMax Int?

  // Pacote agregado enviado à cotação — auditoria (gramas / centímetros).
  packageWeightGrams Int
  packageHeightCm    Int
  packageWidthCm     Int
  packageLengthCm    Int

  quotedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}

// --- Nota fiscal (preparação p/ NF-e — SEM emissão real / SEFAZ) --------

model Invoice {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status InvoiceStatus @default(PENDING)

  number          String?
  series          String?
  accessKey       String? // chave de acesso (44 dígitos) — uso futuro
  xml             String?   @db.Text
  danfeUrl        String? // PDF/DANFE
  issuedAt        DateTime?
  authorizedAt    DateTime?
  rejectionReason String?

  canceledAt        DateTime?
  cancelReason      String?
  cancelProtocol    String?
  cancelRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

// --- Movimentação de estoque (livro-razão) ---------------------------
// Apenas modelagem. Sem baixa automática nem recálculo nesta etapa.

model StockMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  type     StockMovementType
  reason   StockMovementReason @default(OTHER)
  quantity Int // sempre positivo; `type` define o sentido

  orderId String? // origem opcional: pedido que gerou a movimentação
  order   Order?  @relation(fields: [orderId], references: [id])

  userId String? // staff responsável (nulo em movimentações automáticas)
  user   User?   @relation(fields: [userId], references: [id])

  note String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

// --- Histórico do pedido (audit trail leve) -------------------------
// Um registro por transição de status do pedido ou do pagamento.

model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type       OrderEventType
  fromStatus String? // string livre: cobre OrderStatus ou PaymentStatus
  toStatus   String?
  note       String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}
